# Copy to .env and fill in real values. .env is never committed.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Copenhagen

# Database: mysql (default) or sqlite
DB_ENGINE=mysql
DB_NAME=morning_cafe
DB_USER=cafe
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_morning_cafe

# Business settings
CAFE_CURRENCY=DKK
TAKEAWAY_CUP_FEE=0.30
COFFEE_PREP_SECONDS=10
